Subject: [PATCH] phy: qcom: qmp-combo: SM8450 DP-only COM reset, 5nm SSC & S22 TX swing tuning

SPDX-License-Identifier: GPL-2.0-only

Fixes DisplayPort link stability on Samsung Galaxy S22 (SM8450 / r0q):
1. Track USB power state explicitly and perform the OEM QMPPHY_MODE_DP_ONLY
   COM reset sequence when entering 4-lane DP-only mode.
2. Preserve Samsung S22 DTBO TX swing/pre-emphasis tables and apply the OEM
   5nm TX_RES_CODE_LANE_OFFSET_TX (0x0a) and SSC serdes configuration.
3. Implement calibrate_dp_phy callback for AUX timeout recovery.
---
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -1381,6 +1381,21 @@
 	QMP_PHY_INIT_CFG(QSERDES_V5_TX_TX_BAND, 0x04),
 };
 
+/* SM8450 5nm DP TX tuning (stock dp_pll_5nm.c uses 0x0a for TX impedance offset) */
+static const struct qmp_phy_init_tbl sm8450_dp_tx_tbl[] = {
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_VMODE_CTRL1, 0x40),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_PRE_STALL_LDO_BOOST_EN, 0x30),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_INTERFACE_SELECT, 0x3b),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_CLKBUF_ENABLE, 0x0f),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_RESET_TSYNC_EN, 0x03),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_TRAN_DRVR_EMP_EN, 0x0f),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_PARRATE_REC_DETECT_IDLE_EN, 0x00),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_TX_INTERFACE_MODE, 0x00),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_RES_CODE_LANE_OFFSET_TX, 0x0a),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_RES_CODE_LANE_OFFSET_RX, 0x11),
+	QMP_PHY_INIT_CFG(QSERDES_V5_TX_TX_BAND, 0x04),
+};
+
 static const struct qmp_phy_init_tbl qmp_v5_5nm_dp_tx_tbl[] = {
 	QMP_PHY_INIT_CFG(QSERDES_V5_5NM_TX_LANE_MODE_3, 0x51),
 	QMP_PHY_INIT_CFG(QSERDES_V5_5NM_TX_TRANSCEIVER_BIAS_EN, 0x1a),
@@ -2358,6 +2373,7 @@
 	struct phy *usb_phy;
 	enum phy_mode phy_mode;
 	unsigned int usb_init_count;
+	bool usb_powered_on;
 
 	struct phy *dp_phy;
 	unsigned int dp_aux_cfg;
@@ -2897,6 +2913,21 @@
 	.has_pwrdn_delay	= true,
 };
 
+/* Samsung Galaxy S22 (sm8450-r0q) DP TX swing/pre-emphasis from stock DTBO */
+static const u8 qmp_dp_r0q_pre_emphasis[4][4] = {
+	{ 0x00, 0x0e, 0x17, 0xff },
+	{ 0x00, 0x0d, 0x16, 0xff },
+	{ 0x00, 0x0e, 0xff, 0xff },
+	{ 0xff, 0xff, 0xff, 0xff }
+};
+
+static const u8 qmp_dp_r0q_voltage_swing[4][4] = {
+	{ 0x09, 0x11, 0x19, 0xff },
+	{ 0x12, 0x1a, 0x1f, 0xff },
+	{ 0x1c, 0x1f, 0xff, 0xff },
+	{ 0xff, 0xff, 0xff, 0xff }
+};
+
 static const struct qmp_phy_cfg sm8450_usb3dpphy_cfg = {
 	.offsets		= &qmp_combo_offsets_v3,
 
@@ -2913,8 +2944,8 @@
 
 	.dp_serdes_tbl		= qmp_v4_dp_serdes_tbl,
 	.dp_serdes_tbl_num	= ARRAY_SIZE(qmp_v4_dp_serdes_tbl),
-	.dp_tx_tbl		= qmp_v5_dp_tx_tbl,
-	.dp_tx_tbl_num		= ARRAY_SIZE(qmp_v5_dp_tx_tbl),
+	.dp_tx_tbl		= sm8450_dp_tx_tbl,
+	.dp_tx_tbl_num		= ARRAY_SIZE(sm8450_dp_tx_tbl),
 
 	.serdes_tbl_rbr		= qmp_v4_dp_serdes_tbl_rbr,
 	.serdes_tbl_rbr_num	= ARRAY_SIZE(qmp_v4_dp_serdes_tbl_rbr),
@@ -2925,15 +2956,16 @@
 	.serdes_tbl_hbr3	= qmp_v4_dp_serdes_tbl_hbr3,
 	.serdes_tbl_hbr3_num	= ARRAY_SIZE(qmp_v4_dp_serdes_tbl_hbr3),
 
-	.swing_hbr_rbr		= &qmp_dp_v4_voltage_swing_hbr_rbr,
-	.pre_emphasis_hbr_rbr	= &qmp_dp_v4_pre_emphasis_hbr_rbr,
-	.swing_hbr3_hbr2	= &qmp_dp_v3_voltage_swing_hbr3_hbr2,
-	.pre_emphasis_hbr3_hbr2 = &qmp_dp_v4_pre_emphasis_hbr3_hbr2,
+	.swing_hbr_rbr		= &qmp_dp_r0q_voltage_swing,
+	.pre_emphasis_hbr_rbr	= &qmp_dp_r0q_pre_emphasis,
+	.swing_hbr3_hbr2	= &qmp_dp_r0q_voltage_swing,
+	.pre_emphasis_hbr3_hbr2 = &qmp_dp_r0q_pre_emphasis,
 
 	.dp_aux_init		= qmp_v4_dp_aux_init,
 	.configure_dp_tx	= qmp_v4_configure_dp_tx,
 	.configure_dp_clocks	= qmp_v3_configure_dp_clocks,
 	.configure_dp_phy	= qmp_v4_configure_dp_phy,
+	.calibrate_dp_phy	= qmp_v3_calibrate_dp_phy,
 
 	.reset_list		= msm8996_usb3phy_reset_l,
 	.num_resets		= ARRAY_SIZE(msm8996_usb3phy_reset_l),
@@ -3155,6 +3187,27 @@
 		return -EINVAL;
 	}
 
+	/*
+	 * Match Qualcomm/Samsung SM8450 5nm DP PLL (dp_pll_5nm.c):
+	 * msm_dp programs DP_SPREAD_AMP_0_5 in DPCD when sink supports SSC,
+	 * so the QMP DP SerDes must enable matching 0.5% down-spread SSC.
+	 */
+	if (cfg->dp_serdes_tbl == qmp_v4_dp_serdes_tbl) {
+		if (dp_opts->ssc) {
+			u8 step1 = (dp_opts->link_rate == 5400) ? 0x5c : 0x45;
+			u8 step2 = (dp_opts->link_rate == 5400) ? 0x08 : 0x06;
+
+			writel(0x01, serdes + QSERDES_V4_COM_SSC_EN_CENTER);
+			writel(0x00, serdes + QSERDES_V4_COM_SSC_ADJ_PER1);
+			writel(0x36, serdes + QSERDES_V4_COM_SSC_PER1);
+			writel(0x01, serdes + QSERDES_V4_COM_SSC_PER2);
+			writel(step1, serdes + QSERDES_V4_COM_SSC_STEP_SIZE1_MODE0);
+			writel(step2, serdes + QSERDES_V4_COM_SSC_STEP_SIZE2_MODE0);
+		} else {
+			writel(0x00, serdes + QSERDES_V4_COM_SSC_EN_CENTER);
+		}
+	}
+
 	return 0;
 }
 
@@ -3633,12 +3686,15 @@
 	writel(0x0a, qmp->dp_tx + cfg->regs[QPHY_TX_TX_POL_INV]);
 	writel(0x0a, qmp->dp_tx2 + cfg->regs[QPHY_TX_TX_POL_INV]);
 
-	writel(0x27, qmp->dp_tx + cfg->regs[QPHY_TX_TX_DRV_LVL]);
-	writel(0x27, qmp->dp_tx2 + cfg->regs[QPHY_TX_TX_DRV_LVL]);
+	writel(0x2a, qmp->dp_tx + cfg->regs[QPHY_TX_TX_DRV_LVL]);
+	writel(0x2a, qmp->dp_tx2 + cfg->regs[QPHY_TX_TX_DRV_LVL]);
 
 	writel(0x20, qmp->dp_tx + cfg->regs[QPHY_TX_TX_EMP_POST1_LVL]);
 	writel(0x20, qmp->dp_tx2 + cfg->regs[QPHY_TX_TX_EMP_POST1_LVL]);
 
+	if (dp_opts->link_rate)
+		qmp_combo_configure_dp_swing(qmp);
+
 	return 0;
 }
 
@@ -3807,12 +3863,26 @@
 		break;
 
 	case QMPPHY_MODE_DP_ONLY:
+		/*
+		 * Match Qualcomm/Samsung SM8450 dp_catalog_ctrl_usb_reset():
+		 * pulse SW_RESET around TYPEC_CTRL and release all COM reset
+		 * overrides so DP AUX and 4-lane DP PHY are not stalled.
+		 */
+		writel(SW_DPPHY_RESET_MUX | SW_USB3PHY_RESET_MUX,
+		       com + QPHY_V3_DP_COM_RESET_OVRD_CTRL);
 		writel(DP_MODE, com + QPHY_V3_DP_COM_PHY_MODE_CTRL);
+		writel(SW_RESET, com + QPHY_V3_DP_COM_SW_RESET);
+		readl(com + QPHY_V3_DP_COM_SW_RESET);
 
-		/* bring QMP DP PHY PCS block out of reset */
-		qphy_clrbits(com, QPHY_V3_DP_COM_RESET_OVRD_CTRL,
-				SW_DPPHY_RESET_MUX | SW_DPPHY_RESET);
-		break;
+		writel(val, com + QPHY_V3_DP_COM_TYPEC_CTRL);
+		writel(0x00, com + QPHY_V3_DP_COM_SWI_CTRL);
+		writel(0x00, com + QPHY_V3_DP_COM_SW_RESET);
+		readl(com + QPHY_V3_DP_COM_SW_RESET);
+
+		writel(SW_PWRDN, com + QPHY_V3_DP_COM_POWER_DOWN_CTRL);
+		writel(0x00, com + QPHY_V3_DP_COM_RESET_OVRD_CTRL);
+		readl(com + QPHY_V3_DP_COM_RESET_OVRD_CTRL);
+		return 0;
 
 	case QMPPHY_MODE_USB3_ONLY:
 		writel(USB3_MODE, com + QPHY_V3_DP_COM_PHY_MODE_CTRL);
@@ -3954,6 +4024,9 @@
 	unsigned int val;
 	int ret;
 
+	if (qmp->qmpphy_mode == QMPPHY_MODE_DP_ONLY)
+		return 0;
+
 	qmp_configure(qmp->dev, serdes, cfg->serdes_tbl, cfg->serdes_tbl_num);
 
 	/* Tx, Rx, and PCS configurations */
@@ -3988,6 +4061,8 @@
 		goto err_disable_pipe_clk;
 	}
 
+	qmp->usb_powered_on = true;
+
 	return 0;
 
 err_disable_pipe_clk:
@@ -4001,6 +4076,9 @@
 	struct qmp_combo *qmp = phy_get_drvdata(phy);
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
 
+	if (!qmp->usb_powered_on)
+		return 0;
+
 	/* PHY reset */
 	qphy_setbits(qmp->pcs, cfg->regs[QPHY_SW_RESET], SW_RESET);
 
@@ -4012,6 +4090,8 @@
 	qphy_clrbits(qmp->pcs, cfg->regs[QPHY_PCS_POWER_DOWN_CONTROL],
 			SW_PWRDN);
 
+	qmp->usb_powered_on = false;
+
 	return 0;
 }
 
@@ -4511,12 +4591,12 @@
 	qmp->orientation = orientation;
 
 	if (qmp->init_count) {
-		if (qmp->usb_init_count)
+		if (qmp->usb_powered_on)
 			qmp_combo_usb_power_off(qmp->usb_phy);
 		qmp_combo_com_exit(qmp, true);
 
 		qmp_combo_com_init(qmp, true);
-		if (qmp->usb_init_count)
+		if (qmp->usb_init_count && qmp->qmpphy_mode != QMPPHY_MODE_DP_ONLY)
 			qmp_combo_usb_power_on(qmp->usb_phy);
 		if (qmp->dp_init_count)
 			cfg->dp_aux_init(qmp);
@@ -4572,13 +4652,14 @@
 		return 0;
 	}
 
-	dev_dbg(qmp->dev, "typec_mux_set: switching from qmpphy mode %d to %d\n",
-		qmp->qmpphy_mode, new_mode);
+	dev_info(qmp->dev, "typec_mux_set: mode %d -> %d (orientation=%d, init=%u, usb=%u, dp=%u)\n",
+		 qmp->qmpphy_mode, new_mode, qmp->orientation,
+		 qmp->init_count, qmp->usb_init_count, qmp->dp_init_count);
 
 	qmp->qmpphy_mode = new_mode;
 
 	if (qmp->init_count) {
-		if (qmp->usb_init_count)
+		if (qmp->usb_powered_on)
 			qmp_combo_usb_power_off(qmp->usb_phy);
 
 		if (qmp->dp_init_count)
@@ -4589,16 +4670,9 @@
 		/* Now everything's powered down, power up the right PHYs */
 		qmp_combo_com_init(qmp, true);
 
-		if (new_mode == QMPPHY_MODE_DP_ONLY) {
-			if (qmp->usb_init_count)
-				qmp->usb_init_count--;
-		}
-
-		if (new_mode == QMPPHY_MODE_USB3DP || new_mode == QMPPHY_MODE_USB3_ONLY) {
+		if (qmp->usb_init_count &&
+		    (new_mode == QMPPHY_MODE_USB3DP || new_mode == QMPPHY_MODE_USB3_ONLY))
 			qmp_combo_usb_power_on(qmp->usb_phy);
-			if (!qmp->usb_init_count)
-				qmp->usb_init_count++;
-		}
 
 		if (new_mode == QMPPHY_MODE_DP_ONLY || new_mode == QMPPHY_MODE_USB3DP) {
 			if (qmp->dp_init_count)
