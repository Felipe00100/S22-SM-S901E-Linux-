 }
@@ -165,7 +189,7 @@
 	v4l2_ctrl_handler_init(hdl, 1);
 
 	dev_vcm->focus = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_FOCUS_ABSOLUTE,
-		0, cdef->focus_pos_max, cdef->focus_steps, 0);
+		0, cdef->focus_pos_max, cdef->focus_steps, cdef->focus_pos_def);
 
 	if (hdl->error)
 		dev_err(dev_vcm->sd.dev, "%s fail error: 0x%x\n",
@@ -212,16 +236,34 @@
 	if (ret < 0)
 		goto err_cleanup;
 
+	if (ak7375_dev->cdef->keep_powered) {
+		pm_runtime_enable(&client->dev);
+		ret = pm_runtime_resume_and_get(&client->dev);
+		if (ret < 0) {
+			dev_err_probe(&client->dev, ret,
+				      "Failed to power up VCM actuator\n");
+			pm_runtime_disable(&client->dev);
+			goto err_cleanup;
+		}
+	} else {
+		pm_runtime_set_active(&client->dev);
+		pm_runtime_enable(&client->dev);
+	}
+
 	ret = v4l2_async_register_subdev(&ak7375_dev->sd);
 	if (ret < 0)
-		goto err_cleanup;
+		goto err_rpm_put;
 
-	pm_runtime_set_active(&client->dev);
-	pm_runtime_enable(&client->dev);
-	pm_runtime_idle(&client->dev);
+	if (!ak7375_dev->cdef->keep_powered)
+		pm_runtime_idle(&client->dev);
 
 	return 0;
 
+err_rpm_put:
+	if (ak7375_dev->cdef->keep_powered)
+		pm_runtime_put_sync(&client->dev);
+	pm_runtime_disable(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
 err_cleanup:
 	v4l2_ctrl_handler_free(&ak7375_dev->ctrls_vcm);
 	media_entity_cleanup(&ak7375_dev->sd.entity);
@@ -234,6 +276,8 @@
 	struct v4l2_subdev *sd = i2c_get_clientdata(client);
 	struct ak7375_device *ak7375_dev = sd_to_ak7375_vcm(sd);
 
+	if (ak7375_dev->cdef->keep_powered)
+		pm_runtime_put_sync(&client->dev);
 	ak7375_subdev_cleanup(ak7375_dev);
 	pm_runtime_disable(&client->dev);
 	pm_runtime_set_suspended(&client->dev);
@@ -305,32 +349,64 @@
 	/* Wait for vcm to become ready */
 	usleep_range(cdef->power_delay_us, cdef->power_delay_us + 500);
 
-	ret = ak7375_i2c_write(ak7375_dev, cdef->reg_cont,
-			       cdef->mode_active, 1);
-	if (ret) {
-		dev_err(dev, "%s I2C failure: %d\n", __func__, ret);
-		return ret;
-	}
+	if (cdef->standby_before_active) {
+		ret = ak7375_i2c_write(ak7375_dev, cdef->reg_cont,
+				       cdef->mode_standby, 1);
+		if (ret) {
+			dev_err(dev, "%s I2C failure: %d\n", __func__, ret);
+			goto err_disable_reg;
+		}
+		usleep_range(cdef->power_delay_us, cdef->power_delay_us + 500);
 
-	for (val = ak7375_dev->focus->val % cdef->ctrl_steps;
-	     val <= ak7375_dev->focus->val;
-	     val += cdef->ctrl_steps) {
 		ret = ak7375_i2c_write(ak7375_dev, cdef->reg_position,
-				       val << cdef->shift_pos, 2);
-		if (ret)
-			dev_err_ratelimited(dev, "%s I2C failure: %d\n",
-						__func__, ret);
-		usleep_range(cdef->ctrl_delay_us, cdef->ctrl_delay_us + 10);
+				       ak7375_dev->focus->val << cdef->shift_pos, 2);
+		if (ret) {
+			dev_err(dev, "%s I2C failure: %d\n", __func__, ret);
+			goto err_disable_reg;
+		}
+		usleep_range(cdef->ctrl_delay_us, cdef->ctrl_delay_us + 100);
+
+		ret = ak7375_i2c_write(ak7375_dev, cdef->reg_cont,
+				       cdef->mode_active, 1);
+		if (ret) {
+			dev_err(dev, "%s I2C failure: %d\n", __func__, ret);
+			goto err_disable_reg;
+		}
+	} else {
+		ret = ak7375_i2c_write(ak7375_dev, cdef->reg_cont,
+				       cdef->mode_active, 1);
+		if (ret) {
+			dev_err(dev, "%s I2C failure: %d\n", __func__, ret);
+			goto err_disable_reg;
+		}
+
+		for (val = ak7375_dev->focus->val % cdef->ctrl_steps;
+		     val <= ak7375_dev->focus->val;
+		     val += cdef->ctrl_steps) {
+			ret = ak7375_i2c_write(ak7375_dev, cdef->reg_position,
+					       val << cdef->shift_pos, 2);
+			if (ret)
+				dev_err_ratelimited(dev, "%s I2C failure: %d\n",
+							__func__, ret);
+			usleep_range(cdef->ctrl_delay_us, cdef->ctrl_delay_us + 10);
+		}
 	}
 
 	ak7375_dev->active = true;
 
 	return 0;
+
+err_disable_reg:
+	regulator_bulk_disable(ARRAY_SIZE(ak7375_supply_names),
+			       ak7375_dev->supplies);
+	return ret;
 }
 
