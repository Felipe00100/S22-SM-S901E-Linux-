+static void s22SetFlashTorch(int level)
+{
+    std::ofstream f("/sys/class/leds/s2mpb02:white:flash/brightness");
+    if (f.is_open()) {
+        f << level << "\n";
+    }
+    for (int i = 0; i < 4; ++i) {
+        std::ofstream qf("/sys/class/leds/white:flash-" + std::to_string(i) + "/brightness");
+        if (qf.is_open()) {
+            qf << (level > 0 ? 150000 : 0) << "\n";
+        }
+    }
+}
+
+static bool s22FlashRequested()
+{
+    if (const char *env = std::getenv("S22_CAMERA_FLASH")) {
+        if (env[0] == '1') return true;
+    }
+    std::ifstream f("/tmp/s22-camera-flash");
+    int v = 0;
+    if (f.is_open() && (f >> v)) {
+        return v > 0;
+    }
+    return false;
+}
+
 void Worker::capture()
 {
     m_stillCaptureFrames.clear();
+    if (s22FlashRequested()) {
+        s22SetFlashTorch(12);
+        QThread::msleep(90);
+    }
     setMode(CaptureMode::StillImage);
 }
 
