#!/bin/sh
set -eu

# 1. Enable PCIe ASPM L1/L1ss power saving for QCA6490 WLAN (1c00000.pcie)
if [ -w /sys/module/pcie_aspm/parameters/policy ]; then
  echo powersave > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
fi
for l1 in /sys/bus/pci/devices/*/link/l1_aspm /sys/bus/pci/devices/*/link/l1_1_aspm /sys/bus/pci/devices/*/link/l1_2_aspm; do
  [ -w "$l1" ] && echo 1 > "$l1" 2>/dev/null || true
done

# 2. Ensure Wi-Fi power_save is enabled on wlan0
if command -v iw >/dev/null 2>&1 && [ -d /sys/class/net/wlan0 ]; then
  iw dev wlan0 set power_save on 2>/dev/null || true
fi

# 3. Ensure Fingerprint VDD_BTP_1P8 stays off in idle unless explicitly enabled
if [ -w /sys/class/fingerprint/fingerprint/power_enable ]; then
  echo 0 > /sys/class/fingerprint/fingerprint/power_enable 2>/dev/null || true
fi

# 4. Allow unprivileged desktop/CLI battery charge limit control & restore saved limit
if [ -e /sys/class/power_supply/max170xx_battery/charge_control_end_threshold ]; then
  chmod 0666 /sys/class/power_supply/max170xx_battery/charge_control_end_threshold 2>/dev/null || true
  touch /etc/s22-charge-limit.conf 2>/dev/null || true
  chmod 0666 /etc/s22-charge-limit.conf 2>/dev/null || true
  if [ -s /etc/s22-charge-limit.conf ]; then
    cat /etc/s22-charge-limit.conf > /sys/class/power_supply/max170xx_battery/charge_control_end_threshold 2>/dev/null || true
  fi
fi

echo "S22 power-save policy applied: ASPM=$(cat /sys/module/pcie_aspm/parameters/policy 2>/dev/null || echo N/A)"
